# Backend server
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/local_life_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USER=agent
DB_PASSWORD=agentpass

# Redis is mandatory for normal runtime
REDIS_HOST=localhost
REDIS_PORT=6379

# Runtime flags
ALLOW_MOCK_POI=false
AMAP_ENABLED=true
MIMO_ENABLED=true
SEARCH_ENABLED=true
SEARCH_PROVIDER=tavily

# MiMo LLM
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_MAX_TOKENS=4096
MIMO_TEMPERATURE=0.1
MIMO_TIMEOUT_MS=30000

# Amap Web Service
AMAP_WEB_SERVICE_KEY=your-amap-web-service-key
AMAP_BASE_URL=https://restapi.amap.com
AMAP_CITY=
AMAP_DEFAULT_ORIGIN=
AMAP_TIMEOUT_MS=3000

# Tavily Search
TAVILY_API_KEY=your-tavily-api-key
TAVILY_BASE_URL=https://api.tavily.com
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_MS=3000

# Frontend
VITE_API_URL=
